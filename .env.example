# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_dev_password
POSTGRES_PORT=5432

# Used by SQLAlchemy from Milestone 1 onward. The host is "db" inside Compose.
DATABASE_URL=postgresql+psycopg://documind:documind_dev_password@db:5432/documind

# Integration tests run on the host against a separate database that the
# test fixtures create and migrate automatically.
DOCUMIND_TEST_DATABASE_URL=postgresql+psycopg://documind:documind_dev_password@localhost:5432/documind_test

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=8000
DOCUMIND_ENVIRONMENT=development
DOCUMIND_CORS_ORIGINS=http://localhost:5173
DOCUMIND_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------
WEB_PORT=5173
API_PROXY_TARGET=http://api:8000

# -----------------------------------------------------------------------------
# AI providers (wired up in Milestones 3 and 4)
# Keep the real key in .env only. Never use a client-side PUBLIC_ prefix.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# -----------------------------------------------------------------------------
# Ingestion worker
# -----------------------------------------------------------------------------
DOCUMIND_CHUNK_TOKENS=350
DOCUMIND_CHUNK_OVERLAP_TOKENS=50
DOCUMIND_WORKER_POLL_SECONDS=1.0
DOCUMIND_WORKER_STALE_AFTER_SECONDS=300
